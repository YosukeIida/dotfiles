# =====================================================================
# Claude Code アカウント・モード切り替え
# =====================================================================
# cc                   → 現在状態表示
# cc sub               → subscription モードに切り替え
# cc api               → API モードに切り替え
# cc sub 1 / cc sub 2  → アカウント N + subscription
# cc api 1 / cc api 2  → アカウント N + API
# cc 1 / cc 2          → 後方互換（subscription 固定）
cc() {
  local arg1="${1:-}" arg2="${2:-}"
  local account="" mode=""

  if [[ -z "$arg1" ]]; then
    _cc_status; return 0
  fi

  for arg in "$arg1" "$arg2"; do
    [[ -z "$arg" ]] && continue
    case "$arg" in
      api|sub|subscription) mode="$arg" ;;
      [1-9]*)               account="$arg" ;;
      *)
        echo "usage: cc [sub|api] [N]" >&2
        return 1 ;;
    esac
  done

  # 後方互換: cc N のみ → subscription を自動設定
  if [[ -n "$account" && -z "$mode" ]]; then
    mode="sub"
  fi

  # アカウント切り替え
  if [[ -n "$account" ]]; then
    if [[ "$account" == "1" ]]; then
      unset CLAUDE_CONFIG_DIR
    else
      local dir="$HOME/.claude-$account"
      if [[ ! -d "$dir" ]]; then
        echo "Error: $dir not found. Run setup-account.sh $account" >&2
        return 1
      fi
      export CLAUDE_CONFIG_DIR="$dir"
    fi
  fi

  # モード切り替え（ln -sf でシンボリックリンクのまま切り替え）
  if [[ -n "$mode" ]]; then
    local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local dst="$config_dir/settings.json"
    local src
    case "$mode" in
      api)              src="$config_dir/settings.api.json" ;;
      sub|subscription) src="$config_dir/settings.subscription.json" ;;
    esac
    if [[ ! -e "$src" ]]; then
      echo "Error: missing $src" >&2
      return 1
    fi
    ln -sf "$src" "$dst"
  fi

  _cc_status
}

_cc_status() {
  local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  local num="1"
  [[ -n "${CLAUDE_CONFIG_DIR:-}" ]] && num="${CLAUDE_CONFIG_DIR##*-}"

  local mode="subscription"
  local resolved
  resolved=$(readlink "$config_dir/settings.json" 2>/dev/null || echo "")
  [[ "$resolved" == *settings.api.json ]] && mode="api"

  local email="(not logged in)" display_name="" org_name=""
  local json="$config_dir/.claude.json"
  if [[ -f "$json" ]]; then
    IFS=$'\t' read -r email display_name org_name <<< "$(python3 - "$json" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    oa = d.get("oauthAccount") or {}
    print(oa.get("emailAddress","(unknown)"), oa.get("displayName",""), oa.get("organizationName",""), sep="\t")
except Exception:
    print("(parse error)", "", "", sep="\t")
PY
)"
  fi

  echo "account : $num  ($config_dir)"
  echo "mode    : $mode"
  echo "email   : $email${display_name:+  ($display_name)}"
  echo "org     : ${org_name:-(unknown)}"
}


# =====================================================================
# ==== fzf / ghq 連携（Ctrl+Gで “一瞬でcd”） ==========================
# =====================================================================
# 対話シェルかつ ghq/fzf があるときだけ有効化
if [[ $- == *i* ]] && command -v ghq >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
  # fzf の見た目/操作（好みで調整OK）
  export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--height=60% --reverse --border --bind=ctrl-u:half-page-up,ctrl-d:half-page-down"

  # ---- ghq 管理リポから（絶対パス）選択：まずは確実動作の最小版 ----
  _ghq_select_dir() {
    ghq list -p | fzf --prompt='ghq> ' || return 1
  }

  # ---- 選択→cd 本体 --------------------------------------------------
  ghqcd() {
    local d; d="$(_ghq_select_dir)" || return 1
    builtin cd -- "$d" || return 1
  }

  # ---- ZLE ウィジェット登録 ------------------------------------------
  zmodload zsh/zle 2>/dev/null
  _ghqcd_widget() { ghqcd; zle reset-prompt 2>/dev/null || true; }
  zle -N _ghqcd_widget

  # ---- Warp/プラグインの上書き対策：毎回プロンプト直前に再バインド ---
  __ghq_bindkeys() {
    # 既存を一旦解除してから入れる（emacs/vi 両対応）
    bindkey -M emacs -r '^g'  2>/dev/null
    bindkey -M viins -r '^g'  2>/dev/null
    bindkey -M vicmd -r '^g'  2>/dev/null
    bindkey -M emacs '^g' _ghqcd_widget
    bindkey -M viins '^g' _ghqcd_widget
    bindkey -M vicmd '^g' _ghqcd_widget
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd __ghq_bindkeys
  __ghq_bindkeys   # 起動直後にも適用

  # ---- フォールバック：`g⏎` でも起動（既存の g が無い場合のみ） -----
  # Warp など Ctrl+G が使えない環境でも、`g` で同機能を呼べるようにする
  if ! type g >/dev/null 2>&1; then
    g() { ghqcd; }
  fi

  # ---- 補助：コマンド/エディタ起動 ----------------------------------
  alias cdg='ghqcd'
  repo() {
    case "${1:-cd}" in
      l|list) ghq list ;;
      c|cd)   ghqcd ;;
      o|open)
        local d; d="$(_ghq_select_dir)" || return
        if command -v zed >/dev/null 2>&1; then zed "$d";
        elif command -v code >/dev/null 2>&1; then code "$d";
        else ${EDITOR:-vi} "$d"; fi
        ;;
      *) echo "usage: repo [cd|list|open]" >&2; return 2 ;;
    esac
  }

else
  ghqcd() { echo "[ghq/fzf] ghq または fzf が見つかりません。" >&2; return 1; }
fi


