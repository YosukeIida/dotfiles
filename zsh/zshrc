  for f in "$HOME/.fzf.zsh" \
    "$HOME/.config/zsh/fzf/key-bindings.zsh" \
    "/etc/profiles/per-user/$USER/share/fzf/key-bindings.zsh" \
    "$HOME/.nix-profile/share/fzf/key-bindings.zsh" \
    "/opt/homebrew/opt/fzf/shell/key-bindings.zsh" \
    "/usr/local/opt/fzf/shell/key-bindings.zsh"; do
    [[ -r "$f" ]] && source "$f" && break
  done
fi

