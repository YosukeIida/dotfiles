# Home Manager session variables（AGMSG_NODE 等）と sessionPath を読み込む
for _hm_vars in \
  "/etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh" \
  "${HOME}/.nix-profile/etc/profile.d/hm-session-vars.sh"; do
  [[ -f "${_hm_vars}" ]] && source "${_hm_vars}" && break
done
unset _hm_vars

# venv 外での pip install を禁止（system Python を汚さない）
export PIP_REQUIRE_VIRTUALENV=1

# ユーザーローカルバイナリを PATH 先頭に確保する（冪等・何度呼んでもよい）。
#
# 関数にしてあるのは、複数のタイミングで呼び直す必要があるため。
# ~/.zprofile の `brew shellenv` が /opt/homebrew/bin を PATH 先頭へ押し込むので、
# ここ（zshenv）での順序付けはログインシェルでは上書きされる。zprofile は
# 対話・非対話どちらのログインシェルでも読まれるが、zshrc は非対話では読まれない。
# したがって zshrc だけで直すと `zsh -lc` に穴が開く。
#
# 2026-07-28 実測: `zsh -lc` で以下の2つが /opt/homebrew/bin に負けていた。
#   ~/.agents/bin/codex                          （agmsg のシム）
#   ~/.local/share/agent-switch/shims/claude     （hook 用 node を注入する claude シム）
# どちらも本体より先に見つからないと存在意義が無い。
#
# 呼び出し箇所: この直後（全シェル）/ zsh/zprofile（brew shellenv の後）/
#               zsh/zshrc（対話シェルでの最後の砦）
dot_path_priority() {
  local _p
  local -a _prio=(
    "${HOME}/.agents/bin"
    "${HOME}/.local/share/agent-switch/shims"
    "${HOME}/.local/bin"
  )
  for _p in "${_prio[@]}"; do
    path=("${path[@]:#${_p}}")
  done
  path=("${_prio[@]}" "${path[@]}")
  export PATH
}
dot_path_priority

# Figma PAT for figma-console-mcp (expires 2026-09-21; managed by agenix)
[[ -r "${HOME}/.config/figma/pat" ]] && export FIGMA_ACCESS_TOKEN="$(<"${HOME}/.config/figma/pat")"

# agent-switch の setup-claude-account が settings.*.json 等を直リンクする元
export AGSW_CLAUDE_ASSETS_DIR="${HOME}/workspace/github.com/YosukeIida/dotfiles/claude"

# 新しいターミナルは常に personal アカウントの Codex CODEX_HOME で開始する
# （tools/agent-switch/README.md の「デフォルトアカウントを固定したい場合」参照）
#
# 本物の対話ターミナル限定（-o interactive **かつ** stdout が tty）。
# -o interactive だけでは不十分: GUI アプリ（Electron の fix-path-env 系）は内部で
# `zsh -ilc '...'` のように -i を明示してPATH取得用シェルを一度だけ起動し、そこで
# 拾った環境変数を自分のプロセスにキャッシュして以降の子プロセスに使い回す。この
# `-ilc` 呼び出しは -o interactive が真になるが、stdout は端末ではなくパイプなので
# `-t 1` で区別できる。ガード不足だと、CODEX_HOME 未設定のプロセス向けに用意された
# `cx app` の symlink 切替（~/.codex/auth.json）が一切効かなくなる事故が起きる
# （2026-08-03 実測: ChatGPT.app 内蔵の codex app-server が CODEX_HOME=~/.codex-personal
# で起動しており、symlink を labteam に向けても App 側には反映されなかった。
# -o interactive のみのガードでもこの事故は再現した）。
#
# 存在チェックはマーカー（.agsw-profile）で行う。-d だけだと、prefix に偶然一致した
# 未管理ディレクトリでも Codex が直接使えてしまい、cx 側のガードと食い違う。
[[ -o interactive ]] && [[ -t 1 ]] && [[ -f "${HOME}/.codex-personal/.agsw-profile" ]] && export CODEX_HOME="${CODEX_HOME:-${HOME}/.codex-personal}"

# Load direnv in non-interactive shells (for Claude Code)
if ! [[ -o interactive ]] && [[ -f "$PWD/.envrc" ]] && command -v direnv >/dev/null 2>&1; then
  eval "$(direnv export zsh 2>/dev/null)"
fi
