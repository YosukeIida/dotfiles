# ~/.bashrc — Claude Code の Bash ツール（settings.json の CLAUDE_CODE_SHELL=bash）が読む。
# 対話の端末は zsh（zsh/zshrc）を使う。PATH の並びと devshell は、claude の起動時の env
# （zshenv・zprofile と agent-switch の shim）から引き継ぐので、ここでは組み直さない。

# Home Manager の session variables（zsh/zshenv と同じ）
for _hm_vars in \
  "/etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh" \
  "${HOME}/.nix-profile/etc/profile.d/hm-session-vars.sh"; do
  [[ -f "${_hm_vars}" ]] && source "${_hm_vars}" && break
done
unset _hm_vars

export PIP_REQUIRE_VIRTUALENV=1

[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"
