#!/usr/bin/env bash
# Codex CLI 起動シム（PATH 経由で本体より先に見つかる実行可能ファイル）。
#
# shims/claude と同じ構造・同じ理由で存在する。lib/codex.zsh の codex() 関数は
# **対話 zsh でしか定義されない**ため、
#   - 非対話シェル（zsh -c / bash / sh）からの起動
#   - Orca などが自プロセスの env のまま spawn した codex
#     （launchd agent の PATH 先頭にこの shims dir を置いてあるのはこのため。
#      dotfiles-private の nix/hosts/yosuke/mac-studio.nix の launchd.user.agents.orcaApp 参照）
#   - 関数が定義される前に起動していた古いシェル
# では関数側の処理（MCP サーバ用 node の PATH 注入）が効かない。
# シムは実行可能ファイルなのでシェルの種類に依存せず、PATH を継承した子プロセスにも効く。
#
# 関数側に残る login/logout ガードは「認証ファイルを壊させない」ための運用ポリシーで、
# 対話シェルでの確認プロンプトが前提のため、こちらには持ち込まない。
# -f: PATH 要素に含まれるワイルドカードを glob 展開させない
set -ufo pipefail

_self="$0"
_self_dir="$(dirname -- "$_self")"
# PATH に載っているのは symlink 側（~/.local/share/agent-switch/shims）なので、
# 論理パスと物理パスの両方を除外対象にする。
_self_dir_phys="$(cd -- "$_self_dir" 2>/dev/null && pwd -P || printf '%s' "$_self_dir")"

_rt_bin="$HOME/.local/share/codex-runtime/bin"

# 0. 起動した場所の direnv（.envrc の devshell）を読み込む。agent のコマンドは
#    非対話のシェルで走り direnv の hook を通らないので、起動時の env に載せて継承させる。
#    `direnv exec` で包まないのは argv[0] を "claude"/"codex" のまま渡すため（下の exec -a）。
#    .envrc が無い・未 allow なら何も変えない。
#    読み込み済みの印は消して必ず読み直す: ~/.zshenv の export の後に ~/.zprofile の
#    brew shellenv が PATH を並べ替え、印が残ると export が空になり Homebrew の cargo などが
#    devshell のものを隠す。印を残して再読み込みさせる（WATCHES だけ消す）方法は採らない:
#    差分の巻き戻しで PATH が zshenv の時点に戻り、brew の PATH が消える。
if command -v direnv >/dev/null 2>&1; then
  unset DIRENV_DIR DIRENV_DIFF DIRENV_WATCHES
  eval "$(DIRENV_LOG_FORMAT= direnv export bash 2>/dev/null)"
fi

# 1. 自分のディレクトリを PATH から外す（シムが自分自身を再実行しないように）
#
# PATH は手動で分解する。`IFS=:` の単語分割では末尾の空要素が落ちるため。
# 空要素は「カレントディレクトリ」を意味するので、勝手に落とすと PATH の意味が変わる。
_newpath=""
_first=1
_rest="${PATH-}"
while :; do
  case "$_rest" in
    *:*) _dir="${_rest%%:*}"; _rest="${_rest#*:}"; _more=1 ;;
    *)   _dir="$_rest"; _rest=""; _more="" ;;
  esac

  case "$_dir" in
    "$_self_dir" | "$_self_dir_phys") ;;  # 自分のディレクトリは落とす
    *)
      if [[ -n "$_first" ]]; then
        _newpath="$_dir"; _first=""
      else
        _newpath="$_newpath:$_dir"
      fi
      ;;
  esac

  [[ -n "$_more" ]] || break
done

# 2. codex プラグイン（sites 等）の MCP サーバ用 node を PATH 先頭へ冪等に注入する
#    （node をグローバル PATH に置かない方針は変えない。nix/home/files.nix 参照）。
if [[ -d "$_rt_bin" ]]; then
  case ":$_newpath:" in
    *":$_rt_bin:"*) ;;
    *) _newpath="$_rt_bin:$_newpath" ;;
  esac
fi

export PATH="$_newpath"

# 3. 本体を解決する。万一シムに戻るようなら無限ループさせずに失敗させる。
_real="$(command -v codex || true)"
if [[ -z "$_real" ]]; then
  echo "agent-switch codex shim: codex 本体が PATH 上に見つかりません。" >&2
  echo "  Homebrew cask の codex が入っているか確認してください。" >&2
  exit 127
fi
if [[ "$_real" -ef "$_self" ]]; then
  echo "agent-switch codex shim: 自分自身に再帰しています（$_real）。" >&2
  exit 127
fi

# 4. 指示ファイルの `@` の参照を展開して ~/.codex/AGENTS.md に書く。Codex は `@` を展開せず、
#    experience の索引（起動した repo ごとに変わる）と phrasing が届かないため。
#    SessionStart の hook で渡さない: Codex は約 2,500 トークンを超える hook の出力を切る。
_dotfiles="$(cd -- "$_self_dir_phys/../../.." && pwd -P)"
if [[ -f "$HOME/.claude/CLAUDE.md" && -f "$_dotfiles/agents/render-instructions.sh" ]]; then
  bash "$_dotfiles/claude/hooks/experience-inject.sh" </dev/null >/dev/null 2>&1 || true
  # mv で置き換える: 前の版の ~/.codex/AGENTS.md は repo の AGENTS.md への symlink で、> で書くと repo を書き換える
  if _tmp="$(mktemp "$HOME/.codex/AGENTS.md.XXXXXX")"; then
    if bash "$_dotfiles/agents/render-instructions.sh" "$HOME/.claude/CLAUDE.md" >"$_tmp"; then
      mv -f "$_tmp" "$HOME/.codex/AGENTS.md"
    else
      rm -f "$_tmp"
    fi
  fi
fi

# argv[0] は "codex" のまま渡す（Orca の agent 検出や ps を見るスクリプトのため）。
exec -a codex "$_real" "$@"
