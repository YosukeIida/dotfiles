#compdef cc
# cc（Claude Code アカウント・モード切替）の補完。
#
# compdef を直接呼ばず fpath 経由で拾わせているのは、プラグインが compinit より
# 先に source される構成でも順序に依存せず動くようにするため
# （agent-switch.plugin.zsh のコメント参照）。
#
# cc は位置固定の文法（1語目がサブコマンド）なので、補完も位置対応にする。
# 実際に受理されない候補を出すと、`cc app personal` の誤解事故と同種の
# 「表示と実動作の乖離」になる（2026-07-28）。
#   1語目: <name> / list / api / sub
#   2語目: api / sub のみ（1語目が <name> のときだけ）

local -a candidates
local default_name="${AGSW_CLAUDE_DEFAULT_NAME:-labteam}"
local prefix="${AGSW_CLAUDE_HOME_PREFIX:-$HOME/.claude-}"
local out

case $CURRENT in
  2)
    # デフォルトアカウントは dir を持たない（CLAUDE_CONFIG_DIR 未設定）ので別に足す
    candidates=("$default_name" list api sub)
    # common.zsh は補完より必ず先に source されるため _agsw_list_profiles を直接使える
    # （2026-08-04 codex-pr-review 指摘: bin/ 呼び出しの再実装をやめて一本化）。
    out="$(_agsw_list_profiles "$prefix" 2>/dev/null)"
    [[ -n "$out" ]] && candidates+=("${(@f)out}")
    ;;
  3)
    # 1語目がモードや list だった場合、2語目は受理されない
    case "${words[2]}" in
      list|api|sub|subscription|app) candidates=() ;;
      *) candidates=(api sub) ;;
    esac
    ;;
  *)
    candidates=()
    ;;
esac

(( ${#candidates} )) && compadd -- "${(@u)candidates}"
