#!/usr/bin/env bash
# CODEX_HOME プロファイル間の symlink 漏れ検出・自動修復。
#
# 新しい Codex バージョンが ~/.codex に追加したトップレベルのファイル/ディレクトリが
# 各アカウント dir（~/.codex-<name>）へ共有（symlink）されていない場合に検出する。
# 例: .codex-global-state.json が symlink 化から漏れてプロファイル間で分岐した事例
# （2026-07-06 監査）。
#
# --fix を渡すと未共有項目に symlink を張って直す（cx が呼ぶたびに自動実行される）。
# 引数無しなら警告のみ。意図的にプロファイル固有とする項目は下の IGNORE_RE に追記する。
set -uo pipefail

BASE="$HOME/.codex"
PREFIX="${AGSW_CODEX_HOME_PREFIX:-$HOME/.codex-}"
FIX=0
[[ "${1:-}" == "--fix" ]] && FIX=1

# プロファイル固有（auth）・揮発性（ログ/履歴/ランタイムキャッシュ/バックアップ）のため
# 無視する項目。「設定・状態として共有すべきもの」だけが警告に残るように保つ。
#
# .codex-global-state.json: アプリが頻繁に書き換える状態ファイル。この種のファイルは
# 一時ファイル + rename で更新されるため symlink 共有が最初の書き込みで壊れる。
# プロファイル固有（per-instance 状態、history.jsonl と同類）と判断（2026-07-06）。
#
# state_N.sqlite: setup-codex-account の LINKED_ITEMS に元々含まれておらず、
# 各プロファイルが独立した実体DBを持つ設計（memories_N.sqlite とは異なり本体も
# 非共有）。本体が実体ファイルのまま-shm/-walだけ symlink されると、SQLiteが
# 別プロファイルのWALを本体に適用してしまいDBが壊れるため、ファミリー全体を除外する
# （2026-07-10）。
#
# mcp-oauth-locks: OAuthトークンストア用のlock dir。同様に LINKED_ITEMS に無く、
# プロファイル固有として扱う（2026-07-10）。
IGNORE_RE='^(auth\.json|\.credentials\.json|\.codex-global-state\.json(\.bak)?|history\.jsonl|logs?(_[0-9]+)?\.sqlite([-.].*)?|goals_[0-9]+\.sqlite([-.].*)?|state_[0-9]+\.sqlite([-.].*)?|mcp-oauth-locks|log|\.DS_Store|version\.json|\.personality_snapshot.*|\.app-server-state-reconciled.*|config\.toml\.bak.*|ambient-suggestions|app-server-control|app-server-daemon|attachments|browser|chrome-native-hosts.*\.json|computer-use|generated_images|keybindings\.json|node_repl|pets|process_manager|rules|sqlite|vendor_imports|worktrees)$'

# プロファイルの列挙は bin/agsw-list-profiles に一本化する（マーカー付きの dir のみ）。
# このスクリプトは cx 実行ごとに --fix 付きで呼ばれる「唯一の全自動書き込み経路」なので、
# prefix に偶然合致した無関係な dir（例: 別アプリの ~/.codex-*）に symlink を撒かないよう
# 列挙側で確実に除外する。
HELPER="$(dirname "$0")/agsw-list-profiles"

# ヘルパ不在時に黙って空の列挙を返すと「差分なし」と誤報するため、先に確認して中断する
# （process substitution の中で exit しても本体は止まらないので、ここで確認する必要がある）。
if [ ! -x "$HELPER" ]; then
  echo "Error: $HELPER が見つからない/実行可能ではありません。" >&2
  echo "  プロファイルを同定できない状態で symlink を張ると未管理の dir を汚染しかねないため中断します。" >&2
  exit 1
fi

_list_profiles() {
  "$HELPER" "$PREFIX"
}

found=0
while IFS= read -r name; do
  [ -n "$name" ] || continue
  dir="$PREFIX$name"
  fixed=""
  missing=""
  while IFS= read -r entry; do
    printf '%s' "$entry" | grep -Eq "$IGNORE_RE" && continue
    if [ ! -e "$dir/$entry" ] && [ ! -L "$dir/$entry" ]; then
      if [ "$FIX" = "1" ]; then
        ln -sfn "$BASE/$entry" "$dir/$entry"
        fixed="$fixed $entry"
      else
        missing="$missing $entry"
      fi
    fi
  done < <(ls -A "$BASE")
  if [ -n "$fixed" ]; then
    found=1
    echo "✓ codex-drift: プロファイル '$name' に symlink を追加:$fixed"
  fi
  if [ -n "$missing" ]; then
    found=1
    echo "⚠ codex-drift: プロファイル '$name' に未共有の項目:$missing"
    echo "   → check-codex-drift --fix を実行、または意図的なら IGNORE_RE に追記"
  fi
done < <(_list_profiles)

exit 0
