#!/usr/bin/env bash
# CODEX_HOME プロファイル間の symlink 漏れ検出。
#
# 新しい Codex バージョンが ~/.codex に追加したトップレベルのファイル/ディレクトリが
# 各アカウント dir（~/.codex-<name>）へ共有（symlink）されていない場合に警告する。
# 例: .codex-global-state.json が symlink 化から漏れてプロファイル間で分岐した事例
# （2026-07-06 監査）。
#
# 対処: tools/agent-switch/bin/setup-codex-account <name> の共有リストに項目を追加して
# 再実行するか、意図的にプロファイル固有とするなら下の IGNORE_RE に追記する。
set -uo pipefail

BASE="$HOME/.codex"
PREFIX="${AGSW_CODEX_HOME_PREFIX:-$HOME/.codex-}"

# プロファイル固有（auth）・揮発性（ログ/履歴/ランタイムキャッシュ/バックアップ）のため
# 無視する項目。「設定・状態として共有すべきもの」だけが警告に残るように保つ。
#
# .codex-global-state.json: アプリが頻繁に書き換える状態ファイル。この種のファイルは
# 一時ファイル + rename で更新されるため symlink 共有が最初の書き込みで壊れる。
# プロファイル固有（per-instance 状態、history.jsonl と同類）と判断（2026-07-06）。
IGNORE_RE='^(auth\.json|\.credentials\.json|\.codex-global-state\.json(\.bak)?|history\.jsonl|logs?(_[0-9]+)?\.sqlite([-.].*)?|goals_[0-9]+\.sqlite([-.].*)?|log|\.DS_Store|version\.json|\.personality_snapshot.*|\.app-server-state-reconciled.*|config\.toml\.bak.*|ambient-suggestions|app-server-control|app-server-daemon|attachments|browser|chrome-native-hosts.*\.json|computer-use|generated_images|keybindings\.json|node_repl|pets|process_manager|rules|sqlite|vendor_imports|worktrees)$'

found=0
for dir in "$PREFIX"*; do
  [ -d "$dir" ] || continue
  name="${dir#"$PREFIX"}"
  missing=""
  while IFS= read -r entry; do
    printf '%s' "$entry" | grep -Eq "$IGNORE_RE" && continue
    if [ ! -e "$dir/$entry" ] && [ ! -L "$dir/$entry" ]; then
      missing="$missing $entry"
    fi
  done < <(ls -A "$BASE")
  if [ -n "$missing" ]; then
    found=1
    echo "⚠ codex-drift: プロファイル '$name' に未共有の項目:$missing"
    echo "   → setup-codex-account $name の再実行、または意図的なら check-codex-drift の IGNORE_RE に追記"
  fi
done

exit 0
