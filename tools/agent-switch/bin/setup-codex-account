#!/usr/bin/env bash
# Codex CLI/App マルチアカウントセットアップ
# 使い方:
#   ./setup-account.sh migrate <name>   初回移行（既存 ~/.codex の auth.json だけ分離）
#   ./setup-account.sh adopt <name>     実ファイル化した ~/.codex/auth.json を取り込む
#   ./setup-account.sh <name> [--claim] 2アカウント目以降の追加 / 既存 dir の正規化
#
# --claim: 既存の「マーカー無し・空でない」ディレクトリを agent-switch のプロファイル
#          として取り込む。無関係な別アプリのデータを掴む事故を防ぐため、この明示が
#          無い限り拒否する。サブコマンドの `adopt`（実ファイル化した auth.json の
#          取り込み）とは別の概念。
#
# 設計: ~/.codex は今まで通り実体（sessions, history.jsonl, skills, AGENTS.md,
# config.toml等）を持ち続ける。各アカウントディレクトリ(~/.codex-<name>)は
# auth.json だけ実体を持ち、それ以外は全て ~/.codex/* への symlink。
# ~/.codex/auth.json 自体は「今アクティブなアカウント」への symlink になる
# （Codex App/IDE拡張は常に ~/.codex を見るため、これで App 側にも反映される）。
#
# config.toml も共有 symlink にする。Codex の config 書き込みは
# resolve_symlink_write_paths (codex-rs/utils/path-utils) が symlink を終端まで
# 解決してから実体に atomic write するため、symlink は壊れない（ソース確認済み）。
set -euo pipefail

HOME_CODEX="$HOME/.codex"

# ~/.codex-<name> から ~/.codex/* へ symlink するアイテム（実体は~/.codexに置いたまま）
LINKED_ITEMS=(skills AGENTS.md config.toml sessions history.jsonl session_index.jsonl archived_sessions \
              memories memories_1.sqlite memories_1.sqlite-shm memories_1.sqlite-wal \
              goals_1.sqlite transcription-history.jsonl models_cache.json)

# アカウント dir を正規化する（再実行で収束）。共有 symlink を張り直し、
# プロファイル・マーカーを置く。migrate / adopt / add のすべてがここを通るので、
# マーカーを付け忘れる経路が生まれない。
_init_profile() {
  local acct_dir="$1"
  local item

  # cx はマーカーが無い dir を拒否する（prefix が偶然一致した無関係なディレクトリを
  # 掴んで他ツールのデータを汚染するのを防ぐ）。詳細は lib/common.zsh 参照。
  touch "$acct_dir/.agsw-profile"

  for item in "${LINKED_ITEMS[@]}"; do
    if [[ -e "$HOME_CODEX/$item" ]]; then
      # -n: リンク先がディレクトリでも辿らずリンク自体を置き換える（再実行で収束）
      ln -sfn "$HOME_CODEX/$item" "$acct_dir/$item"
    fi
  done
}

# auth.json の .tokens.account_id を取り出す（取れなければ非ゼロ終了・無出力）。
# 実装は bin/agsw-codex-account-id に一本化（codex-auth-doctor と共用）。
# python3 前提のため、無い環境では adopt の同一アカウント判定ができず、既存 dir への
# 取り込みは安全側に倒して拒否される。
_account_id() {
  local helper
  helper="$(dirname "$0")/agsw-codex-account-id"
  [[ -x "$helper" ]] || return 1
  "$helper" "$1"
}

# 既存の「マーカー無し・空でない」dir を agent-switch のプロファイルとして取り込んで
# よいかを判定する。無関係な別アプリのデータ（実例: ~/.claude-science は Claude Science
# アプリ）に symlink を撒いてマーカーを付けると、以後 cx から使えるようになり、
# そのアプリの dir に Codex が書き込み始める。明示の --claim が無い限り拒否する。
#
# 新規 dir（未作成）は何も奪わないので対象外。マーカー付きの dir は既に管理下なので素通し。
_require_claimable() {
  local acct_dir="$1" name="$2" claim="$3"

  [[ -d "$acct_dir" ]] || return 0
  [[ -f "$acct_dir/.agsw-profile" ]] && return 0
  [[ -n "$(ls -A "$acct_dir" 2>/dev/null)" ]] || return 0

  if [[ "$claim" != 1 ]]; then
    {
      echo "Error: $acct_dir は既に存在し、agent-switch の管理下ではありません（.agsw-profile が無い）。"
      echo "  中身:"
      # set -e + pipefail 下で head が先に終了すると ls が SIGPIPE で死に、
      # 案内の残りが出ないまま exit 141 になるため、パイプライン全体を保護する。
      { ls -A "$acct_dir" 2>/dev/null | head -8 | sed 's/^/    /'; } || true
      [[ "$(ls -A "$acct_dir" 2>/dev/null | wc -l)" -gt 8 ]] && echo "    ..."
      echo "  別アプリのデータディレクトリでないことを確認してください。"
      echo "  agent-switch のプロファイルとして取り込むなら:"
      echo "    $0 $name --claim"
    } >&2
    exit 1
  fi
  echo "[--claim] 既存ディレクトリを agent-switch のプロファイルとして取り込みます"
}

migrate() {
  local first="$1"
  local acct_dir="$HOME/.codex-$first"

  if [[ -d "$acct_dir" ]]; then
    echo "Error: already exists: $acct_dir (already migrated?)" >&2
    exit 1
  fi
  if [[ ! -f "$HOME_CODEX/auth.json" ]]; then
    echo "Error: $HOME_CODEX/auth.json not found" >&2
    exit 1
  fi

  mkdir -p "$acct_dir"

  # auth.json だけ実体move。他は一切動かさない（~/.codexに残したまま）。
  mv "$HOME_CODEX/auth.json" "$acct_dir/auth.json"
  ln -sf "$acct_dir/auth.json" "$HOME_CODEX/auth.json"

  _init_profile "$acct_dir"

  echo "Migrated."
  echo "  ~/.codex/auth.json -> $acct_dir/auth.json"
  echo "  $acct_dir/{skills,sessions,history.jsonl,...} -> ~/.codex/* (symlink)"
  echo ""
  echo "Next: 2アカウント目を追加する場合は"
  echo "  bash $(basename "$0") <name>"
}

# 実ファイル化した ~/.codex/auth.json を ~/.codex-<name> に取り込む。
# 事故（CODEX_HOME 未指定の生 login で symlink が実ファイル上書き）からの復旧用。
adopt() {
  local name="$1"
  local claim="${2:-0}"
  local acct_dir="$HOME/.codex-$name"
  local app_auth="${AGSW_CODEX_APP_AUTH:-$HOME_CODEX/auth.json}"

  # 取り込む対象は「実ファイル」であること（symlink/不在なら取り込むものが無い）
  if [[ -L "$app_auth" || ! -e "$app_auth" ]]; then
    echo "Error: $app_auth is not a real file (nothing to adopt)." >&2
    echo "  symlink または不在です。事故で実ファイル化した場合のみ adopt を使います。" >&2
    exit 1
  fi

  # 既存の未管理 dir への取り込みは add_account と同じく --claim を要求する。
  # ここを塞がないと `adopt <name>` が --claim ガードの迂回路になり、無関係な dir に
  # 認証を移して symlink を撒き、cx から使えるようにしてしまう。
  _require_claimable "$acct_dir" "$name" "$claim"

  if [[ ! -d "$acct_dir" ]]; then
    # 新規 dir: migrate と同じ動き
    mkdir -p "$acct_dir"
    mv "$app_auth" "$acct_dir/auth.json"
    ln -sf "$acct_dir/auth.json" "$app_auth"
    _init_profile "$acct_dir"
    echo "Adopted into new $acct_dir"
    echo "  $app_auth -> $acct_dir/auth.json"
    return 0
  fi

  # 既存 dir だが auth.json が無い（add_account 後に未ログイン等）: 破壊するものが
  # 無いのでそのまま取り込む。
  if [[ ! -e "$acct_dir/auth.json" ]]; then
    mv "$app_auth" "$acct_dir/auth.json"
    ln -sf "$acct_dir/auth.json" "$app_auth"
    _init_profile "$acct_dir"
    echo "Adopted into existing $acct_dir (auth.json was absent)"
    return 0
  fi

  # 既存 dir: 既存 auth.json と account_id が一致するときだけ上書き（同一アカウントの
  # 新しいトークン）。異なる or 判定不能なら既存認証の破壊を避けて拒否する。
  local src_id existing_id
  src_id="$(_account_id "$app_auth")" || src_id=""
  existing_id="$(_account_id "$acct_dir/auth.json")" || existing_id=""

  if [[ -n "$src_id" && -n "$existing_id" && "$src_id" == "$existing_id" ]]; then
    mv "$app_auth" "$acct_dir/auth.json"
    ln -sf "$acct_dir/auth.json" "$app_auth"
    _init_profile "$acct_dir"
    echo "Adopted (same account_id=$src_id) into existing $acct_dir"
    return 0
  fi

  echo "Error: account_id が一致しない、または判定できないため拒否します。" >&2
  echo "  取り込み元: ${src_id:-'(不明)'}" >&2
  echo "  既存 $acct_dir/auth.json: ${existing_id:-'(不明)'}" >&2
  echo "  別アカウントとして取り込むには別の <name> を指定してください。" >&2
  exit 1
}

add_account() {
  local name="$1"
  local claim="${2:-0}"
  local acct_dir="$HOME/.codex-$name"
  local existed=0

  if [[ ! -d "$HOME_CODEX" ]]; then
    echo "Error: $HOME_CODEX not found" >&2
    exit 1
  fi

  [[ -d "$acct_dir" ]] && existed=1

  _require_claimable "$acct_dir" "$name" "$claim"

  mkdir -p "$acct_dir"
  _init_profile "$acct_dir"

  # 既存 dir への再実行は「正規化」（共有 symlink の張り直し＋マーカー付与）。
  # マーカー導入時の移行もこの経路を通るため、ログイン済みなら login の案内は出さない。
  if [[ "$existed" == 1 ]]; then
    if [[ -e "$acct_dir/auth.json" ]]; then
      echo "Normalized $acct_dir (共有 symlink とマーカーを再適用。既存の認証はそのまま)"
      return 0
    fi
    echo "Normalized $acct_dir (未ログイン)"
  else
    echo "Created $acct_dir"
  fi

  echo ""
  echo "Next: ログインしてください"
  echo "  CODEX_HOME=\"$acct_dir\" codex login"
}

# 引数解析。サブコマンドを取り出したうえで <name> と --claim を位置に依存せず解釈する。
# `-*` を name として受け入れないのが重要（例: `$0 --claim personal` が
# ~/.codex---claim を作ってしまうのを防ぐ）。
USAGE="usage: $(basename "$0") migrate <name> | $(basename "$0") adopt <name> [--claim] | $(basename "$0") <name> [--claim]"

SUBCMD=""
case "${1:-}" in
  migrate|adopt) SUBCMD="$1"; shift ;;
  ""|-h|--help)  echo "$USAGE"; exit 1 ;;
esac

CLAIM=0
NAME=""
for arg in "$@"; do
  case "$arg" in
    # --claim: 既存の「マーカー無し・空でない」dir を取り込む明示フラグ。
    # サブコマンドの `adopt`（実ファイル化した auth.json の取り込み）とは別概念。
    --claim) CLAIM=1 ;;
    -*)      echo "Error: unknown option: $arg" >&2; echo "$USAGE" >&2; exit 1 ;;
    *)
      if [[ -n "$NAME" ]]; then
        echo "Error: 引数が多すぎます（'$NAME' と '$arg'）。指定できるオプションは --claim のみです。" >&2
        echo "$USAGE" >&2
        exit 1
      fi
      NAME="$arg"
      ;;
  esac
done
[[ -n "$NAME" ]] || { echo "Error: <name> が必要です。" >&2; echo "$USAGE" >&2; exit 1; }

case "$SUBCMD" in
  migrate) migrate "$NAME" ;;
  adopt)   adopt "$NAME" "$CLAIM" ;;
  *)       add_account "$NAME" "$CLAIM" ;;
esac
