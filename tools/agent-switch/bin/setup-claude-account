#!/usr/bin/env bash
# Claude Code マルチアカウントセットアップ（名前制・ln -sf 収束型）
# 使い方: ./setup-claude-account <name>
# 例:     ./setup-claude-account personal
#
# デフォルトアカウント（labteam 相当）は CLAUDE_CONFIG_DIR 未設定の ~/.claude を
# そのまま使うため、このスクリプトの対象外（何も作る必要がない）。
# 認証は macOS Keychain に CLAUDE_CONFIG_DIR ごとのエントリで保存されるため、
# 作成後にそのアカウントで一度 login が必要。
#
# AGSW_CLAUDE_ASSETS_DIR: dotfiles 管理の settings.*.json 等を各アカウント dir へ
# 直接 symlink したい場合にそのディレクトリを指定する（未指定ならスキップ）。
set -euo pipefail

NAME="${1:?usage: setup-claude-account <name>}"
BASE="$HOME/.claude"
DIR="$HOME/.claude-$NAME"
ASSETS_DIR="${AGSW_CLAUDE_ASSETS_DIR:-}"

# assets dir から直接 symlink（各アカウント独立）
# settings.api.json は生成物（gen-api-settings.sh が live + overlay から生成）
ASSET_LINKS=(settings.api.json get_key.sh statusline.sh CLAUDE.md)

# デフォルトアカウント (~/.claude) から共有する項目
SHARED_FROM_BASE=(projects skills todos plans history.jsonl CLAUDE.md)

echo "Setting up: $DIR"
mkdir -p "$DIR"

if [[ -n "$ASSETS_DIR" ]]; then
  for item in "${ASSET_LINKS[@]}"; do
    if [[ -e "$ASSETS_DIR/$item" ]]; then
      ln -sfn "$ASSETS_DIR/$item" "$DIR/$item"
      echo "  linked (assets): $item"
    else
      echo "  skip (not in assets dir): $item"
    fi
  done
else
  echo "  (AGSW_CLAUDE_ASSETS_DIR 未指定のため settings.*.json 等のリンクはスキップ)"
fi

for item in "${SHARED_FROM_BASE[@]}"; do
  if [[ -e "$BASE/$item" || -L "$BASE/$item" ]]; then
    ln -sfn "$BASE/$item" "$DIR/$item"
    echo "  linked (shared): $item"
  else
    echo "  skip (not found): $item"
  fi
done

# settings.json のデフォルト（既存の選択は尊重）:
# assets の settings.json（全アカウント共有の live 設定 = サブスクモード）を指す。
if [[ ! -e "$DIR/settings.json" && ! -L "$DIR/settings.json" ]]; then
  if [[ -n "$ASSETS_DIR" && -e "$ASSETS_DIR/settings.json" ]]; then
    ln -s "$ASSETS_DIR/settings.json" "$DIR/settings.json"
    echo "  linked: settings.json -> (assets) settings.json"
  fi
fi

if [[ ! -f "$DIR/anthropic.env" ]]; then
  echo ""
  echo "  [INFO] API モードを使う場合は以下を作成:"
  echo "    echo 'export ANTHROPIC_API_KEY=\"sk-ant-...\"' > $DIR/anthropic.env && chmod 600 $DIR/anthropic.env"
fi

echo ""
echo "Done. Next: このアカウントでログイン"
echo "  CLAUDE_CONFIG_DIR=$DIR claude   # 起動後 /login"
echo ""
echo "旧アカウントディレクトリから状態を引き継ぐ場合は login 前に:"
echo "  mv <旧dir>/.claude.json <旧dir>/stats-cache.json $DIR/"
