// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "mac-studio",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/yosuke/workspace/github.com/TMLlaboratory/irireshi/./"
          ]
        }
      ]
    }
  ],
  "markdown_preview": {
    "limit_content_width": false,
    "max_width": 800.0
  },
  "disable_ai": false,
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "audio": {
    "experimental.auto_microphone_volume": false,
    "experimental.rodio_audio": false,
  },
  "agent_ui_font_size": 16.0,
  "show_whitespaces": "boundary",
  "soft_wrap": "preferred_line_length",
  "preferred_line_length": 120,
  "show_edit_predictions": true,
  "file_scan_exclusions": [
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db"
  ],
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
      "default_mode": "auto",
    },
    "your_agent": {
      "type": "custom",
      "command": "path_to_executable",
      "args": [],
      "env": {},
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },
  "base_keymap": "VSCode",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-5.5-pro",
    },
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "file_types": {
    "Dockerfile": [
      "Dockerfile",
      "Dockerfile.*",
      "*.Dockerfile",
      "*.dockerfile",
    ],
  },
  "language_models": {
    "openai": {
      "available_models": [
        {
          "name": "gpt-5.1",
          "display_name": "gpt-5.1 high",
          "max_tokens": 400000,
          "reasoning_effort": "high",
        },
      ],
    },
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
    },
    "LaTeX": {
      "autosave": "off",
    },
  },
  "auto_install_extensions": {
    "codebook": true,
    "docker-compose": true,
    "dockerfile": true,
    "html": true,
    "jsonl": true,
    "latex": true,
    "make": true,
    "rainbow-csv": true,
    "toml": true,
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "/Users/yosuke/workspace/github.com/YosukeIida/latex-devkit/bin/latexmk-docker",
            "args": ["%f"],
            "onSave": false,
            "forwardSearchAfter": true,
            "auxDirectory": "build",
            "pdfDirectory": "build",
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-r", "-z", "-b", "%l", "%p"],
          },
        },
      },
    },
  },
}
