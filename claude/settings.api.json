{
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "YosukeIida": {
      "autoUpdate": true,
      "source": {
        "repo": "YosukeIida/claude-lualatex-pdf",
        "source": "github"
      }
    },
    "academic-research-skills": {
      "source": {
        "repo": "Imbad0202/academic-research-skills",
        "source": "github"
      }
    },
    "claude-paper": {
      "source": {
        "repo": "alaliqing/claude-paper",
        "source": "github"
      }
    },
    "daymade-skills": {
      "source": {
        "repo": "daymade/claude-code-skills",
        "source": "github"
      }
    },
    "ecc": {
      "source": {
        "repo": "affaan-m/everything-claude-code",
        "source": "github"
      }
    },
    "fujibee-agmsg": {
      "source": {
        "repo": "fujibee/agmsg",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "fileCheckpointingEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/yosuke/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/check-dotfiles-dirty.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "Japanese",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.claude/anthropic.env)",
      "Edit(~/.claude/anthropic.env)",
      "Write(~/.claude/anthropic.env)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ]
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.agents/skills/agmsg/"
      ]
    }
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "verbose": false,
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  },
  "apiKeyHelper": "~/.claude/get_key.sh"
}
