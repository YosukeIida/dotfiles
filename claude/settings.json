{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(rtk grep:*)",
      "Bash(rtk rg:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk tree:*)",
      "Bash(rtk read:*)",
      "Bash(rtk wc:*)",
      "Bash(rtk du:*)",
      "Bash(rtk json:*)",
      "Bash(rtk deps:*)",
      "Bash(rtk env:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk log:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk cc-economics:*)",
      "Bash(rtk config:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk smart:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git status)",
      "Bash(rtk git status:*)",
      "Bash(intent-cli:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.claude/anthropic.env)",
      "Edit(~/.claude/anthropic.env)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "[ -x \"$GWS_MULTI_ACCOUNT_NODE\" ] && [ -f \"$HOME/.claude/skills/gws-multi-account/hooks/hook.js\" ] && \"$GWS_MULTI_ACCOUNT_NODE\" \"$HOME/.claude/skills/gws-multi-account/hooks/hook.js\" || exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/claude-memory-health.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/yosuke/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/check-dotfiles-dirty.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/suiko-lint.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "agmsg@fujibee-agmsg": true,
    "claude-paper@claude-paper": true,
    "codex@openai-codex": true,
    "document-skills@anthropic-agent-skills": true,
    "exa@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "lualatex-pdf@YosukeIida": true,
    "daymade-docs@daymade-skills": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "eli5@claude-community": true
  },
  "extraKnownMarketplaces": {
    "YosukeIida": {
      "source": {
        "source": "github",
        "repo": "YosukeIida/claude-lualatex-pdf"
      }
    },
    "academic-research-skills": {
      "source": {
        "source": "github",
        "repo": "Imbad0202/academic-research-skills"
      },
      "autoUpdate": true
    },
    "claude-paper": {
      "source": {
        "source": "github",
        "repo": "alaliqing/claude-paper"
      },
      "autoUpdate": true
    },
    "daymade-skills": {
      "source": {
        "source": "github",
        "repo": "daymade/claude-code-skills"
      },
      "autoUpdate": true
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      },
      "autoUpdate": true
    },
    "fujibee-agmsg": {
      "source": {
        "source": "github",
        "repo": "fujibee/agmsg"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "language": "Japanese",
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.agents/skills/agmsg/"
      ]
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "disableDeepLinkRegistration": "disable",
  "voiceEnabled": true
}
