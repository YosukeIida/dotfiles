{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_SHELL": "bash"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(rtk grep:*)",
      "Bash(rtk rg:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk tree:*)",
      "Bash(rtk read:*)",
      "Bash(rtk wc:*)",
      "Bash(rtk du:*)",
      "Bash(rtk json:*)",
      "Bash(rtk deps:*)",
      "Bash(rtk env:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk log:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk cc-economics:*)",
      "Bash(rtk config:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk smart:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git status)",
      "Bash(rtk git status:*)",
      "Bash(intent-cli:*)",
      "Bash(bash /Users/yosuke/.claude/skills/herdr-agent-team/scripts/herdr-team.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.claude/anthropic.env)",
      "Edit(~/.claude/anthropic.env)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:ja-refine-paper": "off",
    "anthropic-skills:ja-refine-grant": "off",
    "anthropic-skills:ja-rigor-probe": "off",
    "anthropic-skills:academic-survey-paper": "off",
    "anthropic-skills:marp-academic-slides": "off",
    "anthropic-skills:thinking-like-gendo": "off",
    "anthropic-skills:cognitive-pattern-extractor": "off",
    "anthropic-skills:interactive-textbook-generator-v2": "off",
    "anthropic-skills:japanese-scientific-writing": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:zemi-report-critique": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "[ -x \"$GWS_MULTI_ACCOUNT_NODE\" ] && [ -f \"$HOME/.claude/skills/gws-multi-account/hooks/hook.js\" ] && \"$GWS_MULTI_ACCOUNT_NODE\" \"$HOME/.claude/skills/gws-multi-account/hooks/hook.js\" || exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/experience-inject.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/herdr-app/mods/paddock/hooks/subagents.sh\"; [ -f \"$f\" ] && sh \"$f\" claude; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/check-dotfiles-dirty.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/experience-queue.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/herdr-peek-agent-cleanup.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/herdr-app/mods/paddock/hooks/subagents.sh\"; [ -f \"$f\" ] && sh \"$f\" claude; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/experience-queue.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/herdr-app/mods/paddock/hooks/subagents.sh\"; [ -f \"$f\" ] && sh \"$f\" claude; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/herdr-app/mods/paddock/hooks/subagents.sh\"; [ -f \"$f\" ] && sh \"$f\" claude; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/herdr-app/mods/paddock/hooks/subagents.sh\"; [ -f \"$f\" ] && sh \"$f\" claude; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
