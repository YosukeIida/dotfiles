#!/usr/bin/env bash
# Arc の Favorites を新しいマシンへ移すための補助。
#
# Arc の Favorites と Space→プロファイルの割り当ては「プロファイル名 × machineID」の組で
# 保存される。しかも **item の中身は同期されない**（コンテナ ID だけが同期され、新マシンでは
# 中身が空のまま作られる）。実測: Air と Studio で topAppsContainerIDs はどちらも
# 合計 16 で一致するのに、そのコンテナに属する item は Studio 側では 0 件。
# 詳細は dotfiles-private/docs/arc-profiles.md 参照。
#
# したがって「旧マシンで export → 新マシンで open」という流れになる。
#   旧マシン: arc-favorites export     → TSV を private overlay に書き出す（要 commit）
#   新マシン: arc-favorites open <対象> → TSV を読んで Arc で順に開く
#
# 登録そのものは手動（開いたタブを Favorites 領域へドラッグ）。Arc には Favorites を
# 作る AppleScript も CLI も無いので、そこは自動化できない。
#
# 設計上の約束: URL とメールアドレスをこのスクリプトに埋め込まない（public リポジトリに
# 置くため）。個人データは private overlay の 2 ファイルに置き、無くても番号のみで動く。
set -uo pipefail

ARC_SUPPORT="$HOME/Library/Application Support/Arc"
SIDEBAR="$ARC_SUPPORT/StorableSidebar.json"
AUTH="$ARC_SUPPORT/StorableAuthState.json"
LOCAL_STATE="$ARC_SUPPORT/User Data/Local State"

PRIVATE_ARC="${ARC_PRIVATE_DIR:-$HOME/workspace/github.com/YosukeIida/dotfiles-private/arc}"
PROFILE_MAP="${ARC_PROFILE_MAP:-$PRIVATE_ARC/profile-accounts.tsv}"
FAV_FILE="${ARC_FAVORITES_FILE:-$PRIVATE_ARC/favorites.tsv}"

usage() {
  cat >&2 <<'USAGE'
usage:
  arc-favorites                前提チェックと Favorites 一覧
  arc-favorites export         この機の Favorites を private overlay の TSV に書き出す
                               （Favorites を持っている旧マシンで実行する）
  arc-favorites open <対象>    Favorites を Arc で順に開く
                               対象はプロファイル名（"Profile 3"）でもメールアドレスでもよい
  arc-favorites restore <対象> StorableSidebar.json に直接書き込んで登録する（要 Arc 終了）
                               先に対象プロファイルで Favorites を 1 件手で登録しておくこと

open の前に、対象アカウントのプロファイルに割り当てた Space を Arc でアクティブに
しておくこと（open はアクティブな Space にタブを開く）。開いたタブを Favorites 領域へ
ドラッグして登録する。
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || die "jq が見つかりません"

# --- プロファイル名 ⇄ アカウント ----------------------------------------------
annotate() {
  local prof="$1" mail=""
  [ -r "$PROFILE_MAP" ] && mail="$(awk -F'\t' '!/^#/ && $1 == p { print $2; exit }' p="$prof" "$PROFILE_MAP")"
  if [ -n "$mail" ]; then printf '%s (%s)' "$prof" "$mail"; else printf '%s' "$prof"; fi
}

resolve() {
  local want="$1"
  case "$want" in
    *@*)
      [ -r "$PROFILE_MAP" ] || die "メールアドレスで指定するには $PROFILE_MAP が必要です"
      awk -F'\t' '!/^#/ && $2 == m { print $1; exit }' m="$want" "$PROFILE_MAP"
      ;;
    *) printf '%s' "$want" ;;
  esac
}

# --- この機の Favorites を StorableSidebar.json から読む ------------------------
# topAppsContainerIDs は [プロファイル指定, コンテナID, ...] の平坦な配列。
# プロファイル指定は {"default":true} か
# {"custom":{"_0":{"directoryBasename":"Profile 3","machineID":"..."}}}。
extract_live() {
  [ -r "$SIDEBAR" ] || return 0
  jq -r '
    ([.. | objects | select(has("topAppsContainerIDs"))] | map(.topAppsContainerIDs) | max_by(length)) as $ids
    | ([range(0; ($ids | length); 2)
        | { key: ($ids[.] | if type == "object" and has("custom")
                            then .custom._0.directoryBasename
                            else "Default" end),
            value: $ids[. + 1] }]
       | from_entries) as $map
    | ([.. | objects | select(has("items")) | .items[] | select(type == "object")]
       | unique_by(.id)) as $items
    | $map | to_entries[]
    | .key as $prof | .value as $cid
    | ($items | map(select(.parentID == $cid))
              | map(.data.tab.savedURL // .data.tab.activeTabURL // empty)) as $urls
    | select($urls | length > 0)
    | $urls[] | "\($prof)\t\(.)"
  ' "$SIDEBAR" 2>/dev/null
}

read_file() {
  [ -r "$FAV_FILE" ] || return 0
  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$FAV_FILE"
}

# この機のデータを優先し、無ければ書き出し済み TSV を使う。
# 結果はグローバルに置く。$(...) で呼ぶとサブシェルになり代入が親に伝わらないため、
# 関数は直接呼ぶこと。
FAV_DATA=""
FAV_SOURCE=""
load_favorites() {
  FAV_DATA="$(extract_live)"
  if [ -n "$FAV_DATA" ]; then
    FAV_SOURCE="このマシンの Arc"
    return
  fi
  FAV_DATA="$(read_file)"
  [ -n "$FAV_DATA" ] && FAV_SOURCE="$FAV_FILE"
  return 0
}

# --- 前提チェック --------------------------------------------------------------
doctor() {
  local ng=0 mail="" locals=""

  [ -r "$AUTH" ] && mail="$(jq -r '.session.user.email // empty' "$AUTH" 2>/dev/null)"
  if [ -n "$mail" ]; then
    echo "  ✓ Arc にサインイン済み: $mail"
  else
    echo "  ✗ Arc にサインインしていません。先に Settings からサインインしてください"
    ng=1
  fi

  # プロファイル番号は作成順で決まりマシンごとに変わりうるので、
  # **このマシンの Local State を正として**アカウント名を出す。
  if [ -r "$LOCAL_STATE" ]; then
    locals="$(jq -r '.profile.info_cache // {} | to_entries[]
                     | select(.key != "Default") | "\(.key)\t\(.value.name // "-")"' \
              "$LOCAL_STATE" 2>/dev/null)"
  fi
  if [ -n "$locals" ]; then
    echo "  ✓ このマシンのプロファイル:"
    printf '%s\n' "$locals" | awk -F'\t' '{ printf "      %-10s %s\n", $1, $2 }'
  else
    echo "  ✗ このマシンにプロファイルがありません（Default のみ）。"
    echo "      Arc の Settings → Profiles で先に作ってください。Favorites は"
    echo "      プロファイルに属するので、作る前に開いても登録先がありません"
    ng=1
  fi

  local assigned
  assigned="$(jq -r '[.. | objects | select(has("profile")) | .profile
                     | select(type == "object" and has("custom"))] | length' "$SIDEBAR" 2>/dev/null)"
  if [ "${assigned:-0}" -gt 0 ]; then
    echo "  i Space の割り当て記録が $assigned 件あります。ただし割り当ても machineID"
    echo "      紐づきなので、旧マシン分はこのマシンには効きません。各 Space を対象"
    echo "      プロファイルに割り当て直してください（Favorites の登録先を決めるため）"
  fi

  if [ -r "$PROFILE_MAP" ]; then
    echo "  ✓ プロファイル対応表: $PROFILE_MAP"
  else
    echo "  i プロファイル対応表がありません（番号のみ表示します）"
    echo "      用意する場合: $PROFILE_MAP に \"Profile 3<TAB>foo@example.com\" 形式で記述"
  fi

  return "$ng"
}

print_grouped() {
  local prev=""
  while IFS=$'\t' read -r prof url; do
    [ -z "$prof" ] && continue
    if [ "$prof" != "$prev" ]; then
      [ -n "$prev" ] && echo ""
      echo "  === $(annotate "$prof") ==="
      prev="$prof"
    fi
    echo "    $url"
  done
}

case "${1:-list}" in
  list)
    echo "== 前提チェック =="
    doctor || echo "  → 上の ✗ を解消してから open を実行してください"
    echo ""
    load_favorites
    if [ -z "$FAV_DATA" ]; then
      echo "== Favorites =="
      echo "  (見つかりません)"
      echo ""
      echo "  Favorites の item は同期されません（コンテナ ID だけが同期される）。"
      echo "  Favorites を持っている旧マシンで 'arc-favorites export' を実行し、"
      echo "  $FAV_FILE を commit / push してから、このマシンで pull してください。"
      exit 1
    fi
    echo "== Favorites（取得元: ${FAV_SOURCE}）=="
    printf "%s\n" "$FAV_DATA" | print_grouped
    echo ""
    echo "登録するには: arc-favorites open \"<プロファイル名 または メールアドレス>\"" >&2
    ;;

  export)
    live="$(extract_live)"
    [ -n "$live" ] || die "このマシンに Favorites がありません。Favorites を持っているマシンで実行してください"
    mkdir -p "$(dirname "$FAV_FILE")" || die "$(dirname "$FAV_FILE") を作成できません"
    {
      echo "# Arc の Favorites（$(hostname -s) から書き出し）"
      echo "# scripts/arc-favorites が読む。形式: <プロファイル名><TAB><URL>"
      echo "# Favorites の item は Arc の同期対象外なので、ここに残して新マシンへ運ぶ。"
      printf '%s\n' "$live"
    } > "$FAV_FILE" || die "$FAV_FILE に書けません"
    n="$(printf '%s\n' "$live" | grep -c .)"
    echo "$FAV_FILE に $n 件書き出しました。private overlay で commit / push してください。" >&2
    printf '%s\n' "$live" | print_grouped
    ;;

  open)
    [ $# -ge 2 ] || {
      usage
      exit 64
    }
    prof="$(resolve "$2")"
    [ -n "$prof" ] || die "\"$2\" に対応するプロファイルが対応表にありません"

    load_favorites
    [ -n "$FAV_DATA" ] || die "Favorites が見つかりません。旧マシンで 'arc-favorites export' を実行して $FAV_FILE を用意してください"

    urls="$(printf '%s\n' "$FAV_DATA" | awk -F'\t' '$1 == p { print $2 }' p="$prof")"
    [ -n "$urls" ] || die "$(annotate "$prof") の Favorites がありません。一覧は arc-favorites で確認してください"

    # 登録先が無い状態で開いても意味がないので、前提を満たさなければ止める。
    if ! doctor >/dev/null; then
      doctor
      die "前提が満たされていません（上を参照）"
    fi

    n="$(printf '%s\n' "$urls" | grep -c .)"
    echo "$(annotate "$prof") の Favorites を $n 件開きます（取得元: ${FAV_SOURCE}）。" >&2
    echo "対象の Space が Arc でアクティブになっていることを確認してください。" >&2
    printf '%s\n' "$urls" | while IFS= read -r u; do
      [ -z "$u" ] && continue
      echo "  → $u" >&2
      open -a Arc "$u" || true
      sleep 1
    done
    echo "開き終えました。各タブを Favorites 領域にドラッグして登録してください。" >&2
    ;;

  restore)
    # StorableSidebar.json に item を直接書く。Arc には Favorites を作るコマンドが
    # 一切無いため（メニュー・AppleScript・CLI すべて確認済み）、これが唯一の自動化手段。
    #
    # 安全策:
    #   - Arc が動いていたら拒否（起動中に書くと Arc の書き戻しで消える）
    #   - 書き込み前にバックアップを取る
    #   - 書き込み後に JSON として妥当か、item 数が期待どおり増えたかを検証し、
    #     おかしければバックアップから戻す
    #   - 「ローカルのコンテナ」を判定するため、対象プロファイルで **手で 1 件登録済み**
    #     であることを要求する。Favorites は同期されないので、item を持つコンテナは
    #     このマシンのものだと確定できる（旧マシンのコンテナは 0 件で来る）
    [ $# -ge 2 ] || {
      usage
      exit 64
    }
    prof="$(resolve "$2")"
    [ -n "$prof" ] || die "\"$2\" に対応するプロファイルが対応表にありません"

    pgrep -x Arc >/dev/null 2>&1 && die "Arc が起動中です。終了してから実行してください（osascript -e 'quit app \"Arc\"'）"
    [ -w "$SIDEBAR" ] || die "$SIDEBAR に書き込めません"

    # 復元したい URL（TSV 優先。live だとこのマシン自身の分になってしまう）
    saved="$(read_file)"
    [ -n "$saved" ] || die "$FAV_FILE がありません。旧マシンで 'arc-favorites export' を実行してください"
    want="$(printf '%s\n' "$saved" | awk -F'\t' '$1 == p { print $2 }' p="$prof")"
    [ -n "$want" ] || die "$(annotate "$prof") の Favorites が $FAV_FILE にありません"

    # このマシンの machineID。Arc が自分の ID を defaults に持っている
    # （ハードウェア UUID とは別物で、Arc が独自に生成する）。これを使えば
    # 「どのコンテナがこのマシンのものか」を手がかり無しに確定できる。
    MACHINE="$(defaults read company.thebrowser.Browser machineID 2>/dev/null)"
    [ -n "$MACHINE" ] || die "Arc の machineID を読めません（company.thebrowser.Browser machineID）"
    echo "このマシンの machineID: $MACHINE" >&2

    # 書き込み先の items 配列。Favorites コンテナが載っている container を使い、
    # 無ければ最も要素数の多いものを選ぶ。
    IDX="$(jq -r --arg prof "$prof" --arg mid "$MACHINE" '
      [ .sidebar.containers | to_entries[]
        | select((.value.items // []) | any(type == "object"
            and .data.itemContainer.containerType.topApps._0.custom._0.directoryBasename == $prof
            and .data.itemContainer.containerType.topApps._0.custom._0.machineID == $mid)) ]
      | (.[0].key // empty)' "$SIDEBAR" 2>/dev/null)"
    if [ -z "$IDX" ]; then
      IDX="$(jq -r '[.sidebar.containers | to_entries[] | {key, n: ((.value.items // []) | length)}]
                    | max_by(.n) | .key' "$SIDEBAR" 2>/dev/null)"
    fi
    [ -n "$IDX" ] || die "書き込み先の sidebar.containers を特定できません"

    CID="$(jq -r --arg prof "$prof" --arg mid "$MACHINE" --argjson idx "$IDX" '
      (.sidebar.containers[$idx].items // [])[] | select(type == "object")
      | select(.data.itemContainer.containerType.topApps._0.custom._0.directoryBasename == $prof
               and .data.itemContainer.containerType.topApps._0.custom._0.machineID == $mid)
      | .id' "$SIDEBAR" 2>/dev/null | head -1)"

    # このマシンの Favorites コンテナがまだ無ければ作る。Arc は初回の登録時に
    # 作るので、一度も登録していないプロファイルでは存在しない。
    CREATE_CONTAINER=0
    if [ -z "$CID" ]; then
      CID="$(uuidgen)"
      CREATE_CONTAINER=1
      echo "このマシンの Favorites コンテナが無いので新規作成します: $CID" >&2
    else
      echo "対象コンテナ: $CID (containers[$IDX])" >&2
    fi

    # 既に入っている URL は飛ばす
    have="$(jq -r --arg cid "$CID" --argjson idx "$IDX" '
      (.sidebar.containers[$idx].items // [])[] | select(type == "object")
      | select(.parentID == $cid) | .data.tab.savedURL // empty' "$SIDEBAR" 2>/dev/null)"
    add="$(printf '%s\n' "$want" | grep -vxF -f <(printf '%s\n' "$have") 2>/dev/null || printf '%s\n' "$want")"
    add="$(printf '%s\n' "$add" | grep . || true)"
    if [ -z "$add" ]; then
      echo "追加するものがありません（すべて登録済み）。" >&2
      exit 0
    fi
    nadd="$(printf '%s\n' "$add" | grep -c .)"

    # CFAbsoluteTime = UNIX 時刻 - 978307200（2001-01-01 起点）
    now=$(( $(date +%s) - 978307200 ))

    new_json="$(
      printf '%s\n' "$add" | while IFS= read -r u; do
        [ -z "$u" ] && continue
        jq -n --arg id "$(uuidgen)" --arg url "$u" --arg dev "$MACHINE" \
              --arg cid "$CID" --argjson t "$now" '
          { createdAt: $t, originatingDevice: $dev, parentID: $cid,
            isUnread: false, title: null,
            data: { tab: { savedTitle: $url, savedURL: $url,
                           savedMuteStatus: "allowAudio", timeLastActiveAt: $t } },
            id: $id, childrenIds: [] }'
      done | jq -s '.'
    )"
    [ -n "$new_json" ] || die "追加する item を組み立てられませんでした"

    backup="$SIDEBAR.bak.$(date +%Y%m%d%H%M%S)"
    cp -p "$SIDEBAR" "$backup" || die "バックアップに失敗しました"
    echo "バックアップ: $backup" >&2

    before="$(jq -r --argjson idx "$IDX" '.sidebar.containers[$idx].items | length' "$SIDEBAR")"
    tmp="$SIDEBAR.new.$$"
    if ! jq --arg cid "$CID" --arg prof "$prof" --arg mid "$MACHINE" \
            --argjson idx "$IDX" --argjson new "$new_json" \
            --argjson t "$now" --argjson mk "$CREATE_CONTAINER" '
      # 必要ならこのマシンの Favorites コンテナを先に作る。
      # 構造は実測に一致させる（data.itemContainer.containerType.topApps._0.custom._0）。
      (if $mk == 1 then
        { createdAt: $t, childrenIds: [], originatingDevice: $mid, id: $cid,
          isUnread: false, parentID: null, title: null,
          data: { itemContainer: { containerType: { topApps: { _0: { custom: { _0:
            { directoryBasename: $prof, machineID: $mid } } } } } } } }
       else null end) as $container
      | (if $mk == 1
         then .sidebar.containers[$idx].items =
                ((.sidebar.containers[$idx].items // []) + [$cid, $container])
         else . end)
      # 新規コンテナは topAppsContainerIDs にも登録する（Arc が引くのはこの索引）。
      | (if $mk == 1
         then .sidebar.containers[$idx].topAppsContainerIDs =
                ((.sidebar.containers[$idx].topAppsContainerIDs // [])
                 + [ { custom: { _0: { directoryBasename: $prof, machineID: $mid } } }, $cid ])
         else . end)
      # items は [id文字列, オブジェクト, ...] の並びなので、両方を追記する
      | .sidebar.containers[$idx].items =
          ((.sidebar.containers[$idx].items // [])
           + (reduce $new[] as $i ([]; . + [$i.id, $i])))
      # コンテナの childrenIds にも登録する
      | .sidebar.containers[$idx].items |= map(
          if type == "object" and .id == $cid
          then .childrenIds += ($new | map(.id))
          else . end)
    ' "$SIDEBAR" > "$tmp"; then
      rm -f "$tmp"
      die "書き込みに失敗しました（元ファイルは無変更）"
    fi

    after="$(jq -r --argjson idx "$IDX" '.sidebar.containers[$idx].items | length' "$tmp" 2>/dev/null)"
    kids="$(jq -r --arg cid "$CID" --argjson idx "$IDX" '
      (.sidebar.containers[$idx].items // [])[] | select(type=="object")
      | select(.id == $cid) | .childrenIds | length' "$tmp" 2>/dev/null)"
    # items には [id文字列, オブジェクト] の 2 要素ずつ入る。コンテナを作った場合はその分も。
    expect=$(( before + nadd * 2 + CREATE_CONTAINER * 2 ))
    if [ "${after:-0}" != "$expect" ] || [ -z "$kids" ]; then
      rm -f "$tmp"
      die "検証に失敗しました（期待 $expect 要素 / 実際 ${after:-?}）。元ファイルは無変更"
    fi

    mv "$tmp" "$SIDEBAR" || die "置き換えに失敗しました。バックアップ: $backup"
    echo "$nadd 件を追加しました（コンテナの childrenIds は $kids 件）。" >&2
    printf '%s\n' "$add" | sed 's/^/  + /' >&2
    echo "" >&2
    echo "Arc を起動して確認してください。想定と違う場合は次で戻せます:" >&2
    echo "  cp \"$backup\" \"$SIDEBAR\"" >&2
    ;;

  -h | --help | help) usage ;;
  *)
    usage
    exit 64
    ;;
esac
