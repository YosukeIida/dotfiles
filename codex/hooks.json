{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/experience-inject.sh",
            "timeout": 10,
            "type": "command",
            "statusMessage": "Loading experience index"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10,
            "statusMessage": "Recalling knowledge notes"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10,
            "statusMessage": "Recalling knowledge notes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --script /Users/yosuke/workspace/github.com/YosukeIida/dotfiles/claude/hooks/knowledge-recall.py",
            "timeout": 10,
            "statusMessage": "Recalling knowledge notes"
          }
        ]
      }
    ]
  }
}
